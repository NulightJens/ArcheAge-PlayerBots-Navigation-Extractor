<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline navigation extractor. Compiles against an already-built AAEmu 1.2 host.
       Pass the host's output folder: dotnet build -p:AAEmuOutput=<path to AAEmu.Game/bin/Debug/net10.0> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AAEmu.NavigationExtractor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The graph and snapshot classes live in this repository, not in the bot module. -->
    <Compile Include="../../src/*.cs" LinkBase="Navigation" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AAEmu.Commons" HintPath="$(AAEmuOutput)\AAEmu.Commons.dll" />
    <Reference Include="AAEmu.Game" HintPath="$(AAEmuOutput)\AAEmu.Game.dll" />
    <Reference Include="NLog" HintPath="$(AAEmuOutput)\NLog.dll" />
  </ItemGroup>

  <Target Name="CheckAAEmuBuild" BeforeTargets="ResolveReferences"
          Condition="'$(AAEmuOutput)' == '' Or !Exists('$(AAEmuOutput)\AAEmu.Game.dll')">
    <Error Text="Build the AAEmu 1.2 server first, then pass -p:AAEmuOutput=&lt;AAEmu.Game output directory&gt;." />
  </Target>
</Project>
